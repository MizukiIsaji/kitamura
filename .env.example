# Supabase > Project Settings > API / Connect dialog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact browser-visible application origin. No trailing path.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# No service_role / secret key is required by this initial application.
# Do not put database passwords or admin keys in NEXT_PUBLIC_* variables.
